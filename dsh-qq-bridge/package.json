{
  "name": "dsh-qq-bridge",
  "version": "0.3.1",
  "description": "QQ AI robot plugin for DeepSeek Harness: SnowLuma bridge, 40+ MCP tools, long-term memory, mood, voice & group management. 把 QQ 变成有记忆、有情绪、会主动聊天的 AI 机器人（本地电脑 / 上云双部署）。",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./qq-tool-restrict.mjs": "./qq-tool-restrict.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "qqbot",
    "qq-bot",
    "qq-robot",
    "onebot",
    "snowluma",
    "mcp",
    "chatbot",
    "chat-memory"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/qq-chat.patch.yml",
        "./presets/qq-chat-v2.patch.yml"
      ]
    }
  },
  "bin": {
    "dsh-qq-bridge": "./bridge/bin/cli.js"
  },
  "files": [
    "lib/",
    "presets/",
    "locale/",
    "icon.svg",
    "qq-tool-restrict.mjs",
    "cordis.patch.yml",
    "deploy/",
    "README.md",
    "LICENSE",
    "bridge/bin/cli.js",
    "bridge/src",
    "!bridge/src/*.bak-*",
    "bridge/roles",
    "bridge/state",
    "bridge/package.json",
    "bridge/config.example.json",
    "bridge/auto-clean.sh",
    "bridge/guardian.sh",
    "bridge/is_running.sh",
    "bridge/pack-soul.sh",
    "bridge/pidof.sh",
    "bridge/recover.sh",
    "bridge/run-bridge.sh",
    "bridge/startup.sh"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@snowluma/sdk": "^2.3.2",
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
